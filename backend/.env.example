# Puerto local de la API
PORT=3000

# URL permitida para el frontend
FRONTEND_URL=http://localhost:5173

# Intervalo predeterminado del monitor en segundos
MONITOR_DEFAULT_INTERVAL_SECONDS=60

# Tiempo máximo de espera por comprobación
MONITOR_DEFAULT_TIMEOUT_MS=10000

# Token opcional para health checks detrás de Cloudflare.
# Debe coincidir con la regla WAF (header X-NOC-Token).
# Sin este valor el monitor sigue funcionando; Cloudflare puede devolver 403.
MONITOR_HEALTH_TOKEN=8fK2mQ9xV7pL4zN6aR3wT1yH5cD0bJ8uE2gM9sX4qW6nF1vP7kA3hZ5rC0dB8jY2

# URLs de los servicios de Presupuesto Participativo
# Sustituir por endpoints reales que respondan sin autenticación o
# configurar sus credenciales en las variables correspondientes.
CMS_ADMIN_HEALTH_URL=
PP_BACKEND_HEALTH_URL=
PP_FRONTEND_URL=
PP_OCR_HEALTH_URL=

# AWS: región y credenciales únicamente si se hará una comprobación
# funcional contra AWS desde el backend.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# URL opcional de un endpoint de estado para OCR/Rekognition.
AWS_REKOGNITION_HEALTH_URL=

# MongoDB: se usará cuando agreguemos la verificación de base de datos.
MONITOR_DB_URI=mongodb://localhost:27017
MONITOR_DB_NAME=noc_monitor

# MongoDB de AppElecciones que será monitoreado
APP_MONGODB_URI=
APP_MONGODB_DATABASES=elections_registry,elections_voting

# Servicios externos opcionales
RENDER_HEALTH_URL=
RAILWAY_HEALTH_URL=

# Correo: se habilitará en la fase de alertas
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
